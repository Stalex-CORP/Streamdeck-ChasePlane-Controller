{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "ChasePlane",
    "Version": "1.0.0.0",
    "Author": "Stalex CORP",
    "Description": "Control ChasePlane (MSFS 2024) from your Stream Deck: switch to any Internal, External or World camera view, toggle cinematic mode and the flashlight. Keys light up while the view or feature is active.",
    "Category": "ChasePlane",
    "CategoryIcon": "imgs/plugin/category-icon",
    "Icon": "imgs/plugin/marketplace",
    "URL": "https://github.com/stalexcorp/streamdeck-msfschaseplane",
    "SupportURL": "https://github.com/stalexcorp/streamdeck-msfschaseplane/issues",
    "CodePath": "bin/plugin.js",
    "UUID": "fr.stalexcorp.msfschaseplane",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24"
    },
    "ApplicationsToMonitor": {
        "windows": [
            "CP MSFS Bridge.exe"
        ]
    },
    "Actions": [
        {
            "Name": "Camera",
            "UUID": "fr.stalexcorp.msfschaseplane.camera",
            "Icon": "imgs/actions/camera/icon",
            "Tooltip": "Switch to a ChasePlane camera view. The key is highlighted while the view is active.",
            "PropertyInspectorPath": "ui/camera.html",
            "Controllers": [
                "Keypad"
            ],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Inactive",
                    "Image": "imgs/actions/camera/keys/default-inactive",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                },
                {
                    "Name": "Active",
                    "Image": "imgs/actions/camera/keys/default-active",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                }
            ]
        },
        {
            "Name": "Cinematic",
            "UUID": "fr.stalexcorp.msfschaseplane.cinematic",
            "Icon": "imgs/actions/cinematic/icon",
            "Tooltip": "Toggle ChasePlane cinematic mode. The key is highlighted while it is on.",
            "Controllers": [
                "Keypad"
            ],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Off",
                    "Image": "imgs/actions/camera/keys/cinematic-inactive"
                },
                {
                    "Name": "On",
                    "Image": "imgs/actions/camera/keys/cinematic-active"
                }
            ],
            "PropertyInspectorPath": "ui/toggle.html"
        },
        {
            "Name": "Flashlight",
            "UUID": "fr.stalexcorp.msfschaseplane.flashlight",
            "Icon": "imgs/actions/flashlight/icon",
            "Tooltip": "Toggle the ChasePlane flashlight. The key is highlighted while it is on.",
            "Controllers": [
                "Keypad"
            ],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Off",
                    "Image": "imgs/actions/camera/keys/flashlight-inactive"
                },
                {
                    "Name": "On",
                    "Image": "imgs/actions/camera/keys/flashlight-active"
                }
            ],
            "PropertyInspectorPath": "ui/toggle.html"
        }
    ]
}
