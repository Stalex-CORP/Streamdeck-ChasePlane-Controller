{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "ChasePlane",
    "Version": "1.0.0.0",
    "Author": "Stalex CORP",
    "Description": "Switch ChasePlane (MSFS 2024) camera views from your Stream Deck. Pick any Internal, External or World view; the key lights up while that view is active.",
    "Category": "ChasePlane",
    "CategoryIcon": "imgs/plugin/category-icon",
    "Icon": "imgs/plugin/marketplace",
    "URL": "https://github.com/stalexcorp/streamdeck-msfschaseplane",
    "SupportURL": "https://github.com/stalexcorp/streamdeck-msfschaseplane/issues",
    "CodePath": "bin/plugin.js",
    "UUID": "fr.stalexcorp.msfschaseplane",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24",
        "Debug": "enabled"
    },
    "ApplicationsToMonitor": {
        "windows": ["CP MSFS Bridge.exe"]
    },
    "Actions": [
        {
            "Name": "Camera",
            "UUID": "fr.stalexcorp.msfschaseplane.camera",
            "Icon": "imgs/actions/camera/icon",
            "Tooltip": "Switch to a ChasePlane camera view. The key is highlighted while the view is active.",
            "PropertyInspectorPath": "ui/camera.html",
            "Controllers": ["Keypad"],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "Inactive",
                    "Image": "imgs/actions/camera/key",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                },
                {
                    "Name": "Active",
                    "Image": "imgs/actions/camera/key-active",
                    "TitleAlignment": "bottom",
                    "FontSize": 9
                }
            ]
        }
    ]
}
